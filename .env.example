# Copy this file to .env.local and fill in your Firebase project's config
# (Project Settings → General → Your apps → SDK setup and configuration).
#
# These values are not secret in the way an API key normally is — Firebase
# web config is meant to be public. What actually protects your data is
# firestore.rules (see that file) plus enabling only email/password auth
# for a personal single-user Nexus.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
